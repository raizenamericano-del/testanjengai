# NEURAL AI STUDIO — server env (dipakai server/dev-proxy.mjs dan versi Next.js).
# Jangan pernah commit file .env yang asli — ini cuma contoh format.
PORT=8787

# --- providers ---
GROQ_API_KEY=
GROQ_A
GEMINI_API_KEY=
NVIDIA_API_KEY=
TAVILY_API_KEY=                      # /api/search — kosong = fitur web search nonaktif

# --- app ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_TOKEN=                         # /api/admin/* nolak request tanpa header x-admin-token ini
NEXTAUTH_SECRET=                     # openssl rand -base64 32

# --- data ---
DATABASE_URL=postgresql://user:***@localhost:5432/neural
DIRECT_URL=postgresql://user:***@localhost:5432/neural
REDIS_URL=redis://localhost:6379

# --- billing (opsional; tanpa ini tombol upgrade jadi simulasi) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENT=

# --- object storage (galeri gambar) ---
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
